# Copy to .env and fill in. `bot-agent` loads it at startup via python-dotenv.

# --- LiveKit ---------------------------------------------------------------
# Must match webapp/.env exactly, otherwise the worker and the browser end up
# on different LiveKit projects and never meet.
LIVEKIT_URL=wss://video-app-fmw62hbn.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM -------------------------------------------------------------------
# DeepSeek and most hosted LLMs expose an OpenAI-compatible API, so the
# OpenAI plugin is used with a custom base_url. You do NOT need an OpenAI
# account: only the key below is read.
LLM_API_KEY=

# DeepSeek's native API. For OpenRouter use https://openrouter.ai/api/v1,
# for a local Ollama use http://localhost:11434/v1, etc.
LLM_BASE_URL=https://api.deepseek.com/v1

# Model name WITHOUT any provider prefix, as DeepSeek's own API expects it.
# DeepSeek's current chat models: "deepseek-chat" (V3 line),
# "deepseek-reasoner" (R1). Verify at https://api-docs.deepseek.com
# If you are actually going through OpenRouter, use the prefixed name there,
# e.g. "deepseek/deepseek-chat".
LLM_MODEL=deepseek-chat

# --- Speech recognition (faster-whisper) -----------------------------------
# tiny | base | small | medium | large-v3 — bigger is more accurate and slower.
WHISPER_MODEL=base

# --- Speech synthesis (Piper) ----------------------------------------------
# ISO 639-1 code used for BOTH recognition and synthesis.
BOT_LANGUAGE=it
# Overrides the default voice for the language. The full list lives in
# stt_tts.DEFAULT_VOICES / https://huggingface.co/rhasspy/piper-voices
# BOT_VOICE=it_IT-paola-medium
# Playback speed multiplier: 1.0 is normal, 0.7 is slower and easier to follow.
BOT_SPEED=0.7

# --- Persona ---------------------------------------------------------------
# BOT_INSTRUCTIONS=Sei un assistente vocale conciso e cordiale.
